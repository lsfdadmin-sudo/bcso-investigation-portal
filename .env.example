# Port for `npm run dev` and `npm start`. Defaults to 4317.
PORT=4317

# Preset role passwords. Applied only when the database is first created.
# Rotate them afterward from Administration inside the portal.
BCSO_PATROL_PASSWORD=patrol412
BCSO_DETECTIVE_PASSWORD=detective08
BCSO_ADMIN_PASSWORD=sheriff01

# SQLite database and uploaded photos. Relative paths are from the project root.
DATA_DIR=data

# Set to true when the portal is served over HTTPS.
BCSO_COOKIE_SECURE=false
